<mujoco model="door_manipulation_scene">
  <!-- Include the Menagerie Panda model -->
  <include file="panda.xml"/>

  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>

  <statistic center="0.3 0.2 0.4" extent="1.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
      rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" rgba="0.45 0.35 0.25 1" specular="0.2" shininess="0.1"/>
    <material name="door_frame_mat" rgba="0.55 0.55 0.55 1"/>
    <material name="door_mat" rgba="0.65 0.45 0.30 1"/>
    <material name="handle_mat" rgba="0.75 0.75 0.78 1" specular="0.8" shininess="0.9"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Panda base mount (small pedestal) -->
    <body name="table" pos="0 0 0.21">
      <geom name="table_top" type="box" size="0.12 0.12 0.01" pos="0 0 0.2" material="table_mat" mass="20"/>
      <geom name="table_leg" type="cylinder" size="0.06 0.2" pos="0 0 0" material="table_mat"/>
    </body>

    <!-- ======== Door assembly ======== -->
    <!-- Door frame (fixed) - positioned within Panda's reach -->
    <body name="door_frame" pos="0.35 0.35 0.42">
      <!-- Left post (where hinge is) -->
      <geom name="frame_left_post" type="box" pos="0 0 0.40" size="0.025 0.025 0.40" material="door_frame_mat"/>
      <!-- Right post -->
      <geom name="frame_right_post" type="box" pos="0.32 0 0.40" size="0.025 0.025 0.40" material="door_frame_mat"/>
      <!-- Top beam -->
      <geom name="frame_top" type="box" pos="0.16 0 0.80" size="0.19 0.025 0.025" material="door_frame_mat"/>

      <!-- Door panel (hinged on left post) -->
      <body name="door_panel" pos="0.0 0.0 0.0">
        <joint name="door_hinge" type="hinge" axis="0 0 1" pos="0 0 0" range="-2.5 0" damping="0.75" frictionloss="0.2"/>
        <inertial pos="0.14 0 0.35" mass="2.0" diaginertia="0.3 0.2 0.1"/>
        <geom name="door_panel_geom" type="box" pos="0.16 0 0.39" size="0.13 0.012 0.38" material="door_mat"/>

        <!-- Door handle (L-shaped lever) -->
        <body name="door_handle" pos="0.25 -0.015 0.35">
          <!-- Stem: perpendicular to door surface (along -Y) -->
          <geom name="handle_stem" type="cylinder" size="0.012 0.035" pos="0 -0.035 0" euler="1.5708 0 0" material="handle_mat" friction="3.0 0.1 0.01"/>
          <!-- Lever: horizontal bar parallel to door, pointing toward hinge (-X) -->
          <geom name="handle_lever" type="capsule" size="0.01 0.05" pos="-0.05 -0.07 0" euler="0 1.5708 0" material="handle_mat" friction="3.0 0.1 0.01"/>
          <site name="handle_grasp_site" pos="-0.025 -0.07 0" size="0.012" rgba="1 0 0 0.5"/>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- Door panel must never collide with its own frame -->
  <contact>
    <exclude body1="door_frame" body2="door_panel"/>
    <exclude body1="door_frame" body2="door_handle"/>
  </contact>

  <!-- ======================== -->
  <!-- Sensors for ROS2 bridge  -->
  <!-- ======================== -->
  <sensor>
    <!-- Joint position sensors -->
    <jointpos name="joint1_pos" joint="joint1"/>
    <jointpos name="joint2_pos" joint="joint2"/>
    <jointpos name="joint3_pos" joint="joint3"/>
    <jointpos name="joint4_pos" joint="joint4"/>
    <jointpos name="joint5_pos" joint="joint5"/>
    <jointpos name="joint6_pos" joint="joint6"/>
    <jointpos name="joint7_pos" joint="joint7"/>
    <!-- Joint velocity sensors -->
    <jointvel name="joint1_vel" joint="joint1"/>
    <jointvel name="joint2_vel" joint="joint2"/>
    <jointvel name="joint3_vel" joint="joint3"/>
    <jointvel name="joint4_vel" joint="joint4"/>
    <jointvel name="joint5_vel" joint="joint5"/>
    <jointvel name="joint6_vel" joint="joint6"/>
    <jointvel name="joint7_vel" joint="joint7"/>
    <!-- Finger sensors -->
    <jointpos name="finger1_pos" joint="finger_joint1"/>
    <jointpos name="finger2_pos" joint="finger_joint2"/>
    <!-- End-effector sensors -->
    <framepos name="ee_pos" objtype="body" objname="hand"/>
    <framequat name="ee_quat" objtype="body" objname="hand"/>
    <!-- Door state -->
    <jointpos name="door_hinge_pos" joint="door_hinge"/>
    <jointvel name="door_hinge_vel" joint="door_hinge"/>
    <!-- Handle grasp site in world frame -->
    <framepos name="handle_pos" objtype="site" objname="handle_grasp_site"/>
    <framequat name="handle_quat" objtype="site" objname="handle_grasp_site"/>
  </sensor>

  <keyframe>
    <key name="home"
         qpos="0 0 0 -1.57079 0 1.57079 -0.7853 0.04 0.04 0"
         ctrl="0 0 0 -1.57079 0 1.57079 -0.7853 255"/>
  </keyframe>
</mujoco>
