<mujoco model="visual servo scene">
  <!--
    Q3: Visual Servoing Scene

    Panda arm (velocity-controlled) on a table.
    A red ball (mocap body) on the same table surface.
    An overhead camera looking straight down.

    The student must use the camera to detect the ball,
    transform its position to the robot frame, and use
    a Jacobian-based velocity controller to track it.
  -->

  <include file="panda_velocity.xml"/>

  <statistic center="0.3 0 0.4" extent="1.5"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-30"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8"
             width="300" height="300"/>
    <texture type="2d" name="table_tex" builtin="flat"
             rgb1="0.6 0.5 0.4" rgb2="0.55 0.45 0.35"
             width="256" height="256"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
    <material name="table_mat" texture="table_tex" texuniform="true"
              rgba="0.7 0.6 0.5 1" specular="0.3" shininess="0.1"/>
    <material name="ball_mat" rgba="0.9 0.1 0.1 1.0" specular="0.8" shininess="0.6"/>
  </asset>

  <worldbody>
    <light pos="0 0 2.5" dir="0 0 -1" directional="true"/>
    <light pos="0.5 0.5 1.5" dir="-0.3 -0.3 -1" diffuse="0.3 0.3 0.3"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Table (same as Q0) — in front of robot -->
    <body name="table" pos="0.5 0 0.2">
      <geom name="table_top" type="box" size="0.3 0.4 0.02" pos="0 0 0.2" material="table_mat" mass="20"/>
      <geom name="table_leg1" type="cylinder" size="0.025 0.2" pos="0.25 0.35 0" material="table_mat"/>
      <geom name="table_leg2" type="cylinder" size="0.025 0.2" pos="-0.25 0.35 0" material="table_mat"/>
      <geom name="table_leg3" type="cylinder" size="0.025 0.2" pos="0.25 -0.35 0" material="table_mat"/>
      <geom name="table_leg4" type="cylinder" size="0.025 0.2" pos="-0.25 -0.35 0" material="table_mat"/>
    </body>

    <!-- Red ball: mocap body (test script moves it around on the table) -->
    <!-- Ball rests on table surface (table top at z=0.42, ball_radius=0.025) -->
    <body name="red_ball" mocap="true" pos="0.5 0.0 0.445">
      <geom name="ball_geom" type="sphere" size="0.025"
            material="ball_mat" contype="0" conaffinity="0"/>
    </body>

    <!-- Overhead camera: looks straight down, centered above the table -->
    <body name="overhead_cam_body" pos="0.5 0.0 1.8">
      <camera name="overhead_cam" mode="fixed"
              pos="0 0 0" quat="0 0.707107 0.707107 0"
              fovy="60"/>
    </body>
  </worldbody>

  <!-- Sensors -->
  <sensor>
    <!-- Joint position sensors -->
    <jointpos name="joint1_pos" joint="joint1"/>
    <jointpos name="joint2_pos" joint="joint2"/>
    <jointpos name="joint3_pos" joint="joint3"/>
    <jointpos name="joint4_pos" joint="joint4"/>
    <jointpos name="joint5_pos" joint="joint5"/>
    <jointpos name="joint6_pos" joint="joint6"/>
    <jointpos name="joint7_pos" joint="joint7"/>

    <!-- Joint velocity sensors -->
    <jointvel name="joint1_vel" joint="joint1"/>
    <jointvel name="joint2_vel" joint="joint2"/>
    <jointvel name="joint3_vel" joint="joint3"/>
    <jointvel name="joint4_vel" joint="joint4"/>
    <jointvel name="joint5_vel" joint="joint5"/>
    <jointvel name="joint6_vel" joint="joint6"/>
    <jointvel name="joint7_vel" joint="joint7"/>

    <!-- End-effector position (gripper center) -->
    <framepos  name="ee_pos"  objtype="site" objname="gripper_center"/>
    <framequat name="ee_quat" objtype="site" objname="gripper_center"/>
  </sensor>
</mujoco>
