            <geom name="mug_handle_bot" type="capsule" fromto="0.055 0 0.02 0.055 0 -0.015" size="0.006" material="mat_mug" mass="0.01" contype="0" conaffinity="0"/>
            <site name="obj_mug_site" pos="0 0 0" size="0.005" rgba="1 0 0 0.5"/>
        </body>

        <!-- Bottle on table 1 (wide base + tapered neck + cap) -->
        <body name="obj_bottle" pos="0.95 0.75 0.35">
            <geom name="bottle_base" type="cylinder" size="0.028 0.05" material="mat_bottle" mass="0.3"/>
            <geom name="bottle_neck" type="cylinder" size="0.014 0.03" pos="0 0 0.08" material="mat_bottle" mass="0.05"/>
