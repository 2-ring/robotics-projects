        <body name="table_3" pos="-0.85 0.85 0">
            <geom name="table3_top" type="box" pos="0 0 0.33" size="0.20 0.22 0.02" material="mat_table" mass="10"/>
            <geom name="table3_leg1" type="cylinder" size="0.02 0.165" pos="0.16 0.18 0.165" material="mat_table"/>
            <geom name="table3_leg2" type="cylinder" size="0.02 0.165" pos="-0.16 0.18 0.165" material="mat_table"/>
