            <geom name="mug_body" type="cylinder" size="0.035 0.04" material="mat_mug" mass="0.25"/>
            <geom name="mug_rim" type="cylinder" size="0.038 0.005" pos="0 0 0.04" material="mat_mug" mass="0.02"/>
