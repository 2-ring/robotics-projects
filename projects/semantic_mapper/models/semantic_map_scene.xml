        <geom name="wall_east" type="box" pos="1.5 0 0.25" size="0.04 1.5 0.25" material="mat_wall"/>
        <geom name="wall_west" type="box" pos="-1.5 0 0.25" size="0.04 1.5 0.25" material="mat_wall"/>

        <!-- Internal partition (horizontal, center) -->
        <geom name="partition_1" type="box" pos="0.0 0.0 0.25" size="0.5 0.04 0.25" material="mat_wall"/>

        <!-- Table 1: northeast -->
